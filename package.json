{
  "name": "jinge-website",
  "version": "1.0.0",
  "private": true,
  "description": "Jinge 官方网站与文档",
  "keywords": [],
  "license": "AGPL-3.0",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "node scripts/intl.mjs && node scripts/content.mjs && vite build && node scripts/verify-build.mjs",
    "check": "pnpm lint && pnpm build",
    "content": "node scripts/intl.mjs && node scripts/content.mjs",
    "dev": "node scripts/intl.mjs && node scripts/content.mjs && vite --host 127.0.0.1",
    "format": "oxfmt",
    "intl": "node scripts/intl.mjs",
    "lint": "pnpm typecheck && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "typecheck": "node scripts/intl.mjs && node scripts/content.mjs && tsc --noEmit"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "jinge": "4.2.0",
    "jinge-router": "4.2.0",
    "todomvc-app-css": "^2.4.3",
    "todomvc-common": "^1.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "husky": "^9.1.7",
    "jinge-compiler": "4.2.0",
    "lint-staged": "^17.6.0",
    "marked": "18.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shiki": "4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@12.16.1"
}
